{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/studio/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/_next/(.*)",
      "headers": [{ "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }]
    }
  ]
}
